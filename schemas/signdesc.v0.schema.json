{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://marionet.local/schemas/signdesc.v0.schema.json",
  "title": "marionet.signdesc/v0",
  "description": "Phonological IR. Extra lexicon fields (source, library, features) are allowed. Hand-written checks in src/ir.js remain the browser validator.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "id", "language", "gloss", "spoken", "handed", "dominant"],
  "properties": {
    "schema": { "const": "marionet.signdesc/v0" },
    "id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "gloss": { "type": "string", "minLength": 1 },
    "spoken": { "type": "array", "items": { "type": "string" } },
    "handed": {
      "type": "string",
      "enum": ["1h", "2h-symmetric", "2h-asymmetric", "2h-alternating"]
    },
    "dominant": { "$ref": "#/definitions/articulator" },
    "nondominant": { "$ref": "#/definitions/articulator" },
    "compileReady": { "type": "boolean" },
    "body": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "head": {
          "type": "string",
          "enum": ["neutral", "tilt-left", "tilt-right", "turn-left", "turn-right", "nod", "shake"]
        },
        "torso": { "type": "string", "enum": ["neutral", "lean-left", "lean-right", "forward"] }
      }
    },
    "nmf": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "eyebrows": { "type": "string", "enum": ["neutral", "raised", "furrowed"] },
        "mouth": { "type": "string", "enum": ["neutral", "open", "spread", "pursed"] },
        "eyegaze": { "type": "string", "enum": ["neutral", "left", "right", "up", "down", "hand"] },
        "head": {
          "type": "string",
          "enum": ["neutral", "tilt-left", "tilt-right", "turn-left", "turn-right", "nod", "shake"]
        },
        "torso": { "type": "string", "enum": ["neutral", "lean-left", "lean-right", "forward"] }
      }
    }
  },
  "definitions": {
    "articulator": {
      "type": "object",
      "additionalProperties": true,
      "required": ["handshape"],
      "properties": {
        "handshape": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
          ]
        },
        "orientation": {
          "type": "string",
          "enum": ["palm-out", "palm-in", "palm-down", "palm-up", "palm-side"]
        },
        "location": { "type": "string" },
        "movement": { "type": "array" }
      }
    }
  }
}
